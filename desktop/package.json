{
  "name": "antrian-bri-console",
  "version": "1.0.0",
  "description": "Antrian BRI Console Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.antrianbri.console",
    "productName": "Antrian BRI Console",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "tray.ico",
      ".env"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
